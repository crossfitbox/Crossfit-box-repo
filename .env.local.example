# Copia este archivo a .env.local y completa con tus valores reales de Supabase.

# Usadas por el service role (lib/supabase-admin.ts) — SOLO servidor,
# acceso completo sin pasar por RLS. Nunca se exponen al navegador.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Usadas por el login y la verificación de sesión (lib/supabase-server.ts,
# lib/supabase-browser.ts, middleware.ts). El prefijo NEXT_PUBLIC_ es
# necesario porque el cliente de navegador las necesita — la anon key
# está diseñada para exponerse, siempre y cuando RLS esté bien
# configurado (ya lo está, ver schema_crossfit_app.sql).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
